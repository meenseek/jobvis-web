{
  "name": "jobvis-web",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:api": "JOBVIS_API_MODE=api NEXT_PUBLIC_JOBVIS_API_MODE=api next dev",
    "dev:local": "JOBVIS_API_MODE=local NEXT_PUBLIC_JOBVIS_API_MODE=local next dev",
    "dev:mock": "JOBVIS_API_MODE=mock NEXT_PUBLIC_JOBVIS_API_MODE=mock next dev",
    "build": "next build",
    "build:sites": "vinext build",
    "start": "next start",
    "start:api": "JOBVIS_API_MODE=api NEXT_PUBLIC_JOBVIS_API_MODE=api next start",
    "start:local": "JOBVIS_API_MODE=local NEXT_PUBLIC_JOBVIS_API_MODE=local next start",
    "start:mock": "JOBVIS_API_MODE=mock NEXT_PUBLIC_JOBVIS_API_MODE=mock next start",
    "contract:generate": "openapi-typescript ../jobvis-api/openapi/jobvis-v1.yaml -o src/contracts/jobvis-api.generated.ts",
    "test": "JOBVIS_API_MODE=api NEXT_PUBLIC_JOBVIS_API_MODE=mock NEXT_PUBLIC_JOBVIS_AUTH_BYPASS=1 npm run build -- --webpack && NEXT_PUBLIC_JOBVIS_AUTH_BYPASS=1 node --test tests/rendered-html.test.mjs && npm run test:sites",
    "test:sites": "JOBVIS_API_MODE=sites NEXT_PUBLIC_JOBVIS_API_MODE=sites JOBVIS_TRUSTED_SITE_SECRET=test-only-site-gateway-secret-32-bytes npm run build:sites && node --test tests/sites-runtime.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@measure-twice/react": "^0.4.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.2",
    "pretendard": "^1.3.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "^0.2.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-rsc": "^0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "openapi-typescript": "^7.13.0",
    "react-server-dom-webpack": "^19.2.6",
    "sass": "^1.103.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.2",
    "vite": "^8.0.13"
  },
  "type": "module"
}
